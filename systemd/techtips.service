[Unit]
Description=Tech Tips tray + scheduler
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.config/techtips
EnvironmentFile=%h/.config/techtips/.env
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStart=%h/.local/bin/techtips -tray
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
